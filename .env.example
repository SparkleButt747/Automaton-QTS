# ============================================================
# QTS Environment Configuration
# Copy to .env and fill in your values. Never commit .env!
# ============================================================

# --- Application ---
QTS_ENV=development
QTS_LOG_LEVEL=INFO
QTS_DRY_RUN=true

# --- Exchange Credentials ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- Market Data ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# --- LLM Backend ---
# Set LLM_BACKEND to 'ollama' for local inference (no API key required)
# or 'anthropic' to use Anthropic Claude (requires ANTHROPIC_API_KEY).
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# --- Reddit / Social Data ---
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=QTS/1.0 by your_username

# --- Database ---
# SQLite (default for local development):
DATABASE_URL=sqlite:///data/trading.db
# PostgreSQL / TimescaleDB (for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qts

# --- Redis / Task Queue ---
REDIS_URL=redis://localhost:6379/0
